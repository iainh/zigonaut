<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Zigonaut"
    Manufacturer="Zigonaut"
    Language="1033"
    Version="$(var.Version)"
    UpgradeCode="$(var.UpgradeCode)"
    Scope="perUser">
    <!-- MSI cannot compare prerelease labels, so releases with the same numeric
         core replace one another. The release filename retains the full version. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Zigonaut is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="COMPANYFOLDER" Name="Spiralpoint">
        <Directory Id="INSTALLFOLDER" Name="Zigonaut">
          <Files Include="$(var.StagingDir)\**" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Zigonaut">
        <Component Id="ApplicationShortcut">
          <Shortcut
            Id="StartMenuShortcut"
            Name="Zigonaut"
            Description="Zigonaut terminal emulator"
            Target="[INSTALLFOLDER]zigonaut.exe"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\Spiralpoint\Zigonaut"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
