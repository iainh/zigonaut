#!/usr/bin/env bash
set -euo pipefail

amp_orbs_revision="fcb5e318e59d6374081a45bc7769acf01cee0dd2"
common_setup_url="https://raw.githubusercontent.com/iainh/amp-orbs/${amp_orbs_revision}/orb-setup"
zig_version="0.17.0"
zig_archive="zig-x86_64-linux-${zig_version}.tar.xz"
zig_url="https://ziglang.org/download/${zig_version}/${zig_archive}"
zig_sha256="1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026"
zig_install_dir="$HOME/.local/share/zig/${zig_version}"

temporary_directory="$(mktemp -d)"
trap 'rm -rf "$temporary_directory"' EXIT

echo "Applying shared Amp orb setup..."
curl --fail --silent --show-error --location \
  "$common_setup_url" \
  --output "$temporary_directory/orb-setup"
bash "$temporary_directory/orb-setup"

if ! pkg-config --exists 'gtk4 >= 4.18' 'libadwaita-1 >= 1.7' 'glib-2.0 >= 2.84' 'libpng >= 1.6.48' ||
   ! command -v Xvfb >/dev/null 2>&1 || ! command -v xdotool >/dev/null 2>&1 || ! command -v xclip >/dev/null 2>&1 ||
   ! command -v import >/dev/null 2>&1 || ! command -v dbus-launch >/dev/null 2>&1 ||
   ! /usr/bin/python3 -c 'import pyatspi; from PIL import Image, ImageGrab' >/dev/null 2>&1; then
  echo "Installing GTK frontend and headless UI test dependencies..."
  sudo apt-get update -qq
  sudo apt-get install -y libgtk-4-dev libadwaita-1-dev libpng-dev pkg-config xvfb xauth xdotool xclip python3-pil python3-pyatspi dbus-x11 imagemagick fonts-dejavu-core
fi

# Do not report success when the host's repositories predate the baseline.
if ! pkg-config --print-errors --exists 'gtk4 >= 4.18' 'libadwaita-1 >= 1.7' 'glib-2.0 >= 2.84' 'libpng >= 1.6.48'; then
  echo "Linux builds require Debian 13 (trixie) or equivalent development libraries." >&2
  exit 1
fi

if ! command -v zig >/dev/null 2>&1 || [[ "$(zig version)" != "$zig_version" ]]; then
  echo "Installing Zig ${zig_version}..."
  curl --fail --silent --show-error --location \
    "$zig_url" \
    --output "$temporary_directory/$zig_archive"
  echo "$zig_sha256  $temporary_directory/$zig_archive" | sha256sum --check --status

  rm -rf "$zig_install_dir"
  mkdir -p "$(dirname "$zig_install_dir")"
  tar -xJf "$temporary_directory/$zig_archive" -C "$(dirname "$zig_install_dir")"
  mv "$(dirname "$zig_install_dir")/zig-x86_64-linux-${zig_version}" "$zig_install_dir"

  mkdir -p "$HOME/.local/bin"
  ln -sfn "$zig_install_dir/zig" "$HOME/.local/bin/zig"
fi

# Zig 0.16.0 rejects resolv.conf files without a trailing newline. Amp orbs can
# generate the file in that form, even though other DNS clients accept it.
if [[ -s /etc/resolv.conf && -n "$(tail -c 1 /etc/resolv.conf)" ]]; then
  echo "Repairing /etc/resolv.conf for Zig..."
  printf '\n' | sudo tee -a /etc/resolv.conf >/dev/null
fi

echo "Fetching Zig dependencies..."
mkdir -p "${ZIG_GLOBAL_CACHE_DIR:-$HOME/.cache/zig}/tmp"
for attempt in 1 2 3; do
  if zig build --fetch; then
    break
  fi
  if [[ "$attempt" == 3 ]]; then
    echo "Unable to fetch Zig dependencies after ${attempt} attempts." >&2
    exit 1
  fi
  sleep "$((10 * attempt))"
done

echo "Orb setup complete."
