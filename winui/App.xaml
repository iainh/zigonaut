<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ZigonautWinUIBridge.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ZigonautTerminalBorderBrush" Color="#18000000" />
                    <SolidColorBrush x:Key="ZigonautTerminalBackgroundBrush" Color="#12000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ZigonautTerminalBorderBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ZigonautTerminalBackgroundBrush" Color="#16FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ZigonautTerminalBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ZigonautTerminalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            <VerticalAlignment x:Key="TitleBarContentVerticalAlignment">Bottom</VerticalAlignment>
            <x:Double x:Key="TitleBarMinDragRegionWidth">46</x:Double>
            <Thickness x:Key="TabViewHeaderPadding">0</Thickness>
            <Thickness x:Key="TabViewItemBorderThickness">1,1,1,0</Thickness>

            <Style x:Key="ZigonautTitleBarButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="ZigonautTerminalFrameStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{ThemeResource ZigonautTerminalBackgroundBrush}" />
            </Style>

            <Style x:Key="ZigonautTitleBarDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Background" Value="{ThemeResource ZigonautTerminalBorderBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
